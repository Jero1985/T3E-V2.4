# --- HAUPT KONFIGURATION (display-flur.yaml) ---
esphome:
  name: display-flur
  on_boot:
    priority: 600
    then:
      - delay: 1s
      - output.turn_on: backlight_output

packages: 
  hardware: !include display_base.yaml

# =========================
# GLOBALS
# =========================

globals:
  - id: page
    type: int
    restore_value: no
    initial_value: '0'
  - id: last_button
    type: int
    restore_value: no
    initial_value: '0'

# =========================
# HINTERGRUNDBILD
# =========================

image:
  - file: "images/bunt.jpg"
    id: mein_hintergrund
    type: RGB

# =========================
# FONT
# =========================

font:
  - file: "gfonts://Roboto"
    id: font_big
    size: 32

  - file: "gfonts://Roboto"
    id: font_small
    size: 20

# =========================
# LVGL
# =========================

lvgl:
  id: my_lvgl
  buffer_size: 25%
  color_depth: 16

  # 🔥 WICHTIG: verhindert Scrollverhalten
  scrollable: false

  pages:
    - id: main_page

      widgets:

        # =========================
        # HINTERGRUND (fix, kein Scroll)
        # =========================
        - image:
            src: mein_hintergrund
            x: 0
            y: 0
            width: 480
            height: 480

        # =========================
        # BUTTON 1
        # =========================
        - button:
            x: 20
            y: 20
            width: 200
            height: 150
            bg_color: 0x4444FF
            on_press:
              - lambda: |-
                  id(last_button) = 1;
              - script.execute: update_status
            widgets:
              - label:
                  text: "BTN 1"
                  align: CENTER

        # =========================
        # BUTTON 2
        # =========================
        - button:
            x: 260
            y: 20
            width: 200
            height: 150
            bg_color: 0x44FF44
            on_press:
              - lambda: |-
                  id(last_button) = 2;
              - script.execute: update_status
            widgets:
              - label:
                  text: "BTN 2"
                  align: CENTER

        # =========================
        # BUTTON 3
        # =========================
        - button:
            x: 20
            y: 200
            width: 200
            height: 150
            bg_color: 0xFF4444
            on_press:
              - lambda: |-
                  id(last_button) = 3;
              - script.execute: update_status
            widgets:
              - label:
                  text: "BTN 3"
                  align: CENTER

        # =========================
        # BUTTON 4
        # =========================
        - button:
            x: 260
            y: 200
            width: 200
            height: 150
            bg_color: 0xFFFF44

            on_press:
              - lambda: |-
                  id(last_button) = 4;
              - script.execute: update_status

            widgets:
              - label:
                  text: "BTN 4"
                  align: CENTER

        # =========================
        # STATUS ANZEIGE (immer sichtbar)
        # =========================
        - label:
            id: status_label
            x: 0
            y: 0
            width: 480
            height: 100
            align: CENTER
            text: "Touch Test"
            text_align: CENTER
            bg_color: 0x000000
            text_color: 0xFFFFFF

# =========================
# Skripte
# =========================

script:
  - id: update_status
    then:
      - lvgl.label.update:
          id: status_label
          text: !lambda |-
            if (id(last_button) == 1) return std::string("Button 1 gedrückt");
            if (id(last_button) == 2) return std::string("Button 2 gedrückt");
            if (id(last_button) == 3) return std::string("Button 3 gedrückt");
            if (id(last_button) == 4) return std::string("Button 4 gedrückt");
            return std::string("Touch Test");
      - component.update: tft_display
