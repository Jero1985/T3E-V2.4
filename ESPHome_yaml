esphome:
  name: display-flur
  on_boot:
    priority: 600
    then:
      - delay: 1s
      - light.turn_on: display_backlight
      - lambda: 'id(tft_display).update();'

esp32:
  board: esp32-s3-devkitc-1
  variant: esp32s3
  flash_size: 16MB
  cpu_frequency: 240MHz
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_ESP_CONSOLE_UART_NONE: "y"
      CONFIG_USB_OTG_ENABLED: "n"
      CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG: "n"
      CONFIG_SPIRAM_RODATA: "y"
      CONFIG_SPIRAM_FETCH_INSTRUCTIONS: "y"

psram:
  mode: octal
  speed: 80MHz

text_sensor:
  - platform: tuya_zigbee_router
    zigbee_status:
      name: "Zigbee Router Status"
      id: zigbee_status_sensor

external_components:
  - source: github://rtorrente/esphome-tuya-zigbee-router

logger:
  level: INFO
  hardware_uart: UART0
  baud_rate: 0

wifi:
  ssid: "!secret wifi_ssid"
  password: "!secret wifi_password"

api:
  reboot_timeout: 0s
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome

font:
  - file: "gfonts://Roboto"
    id: my_font
    size: 20

image:
  - file: "test.png"
    id: test_bild
    type: RGB

i2c:
  - id: bus_a
    sda: GPIO7
    scl: GPIO6
    scan: true
    frequency: 100kHz

touchscreen:
  - platform: gt911
    id: my_touch
    display: tft_display
    i2c_id: bus_a
    # Wir lassen die Adresse weg -> Auto-Scan 0x14/0x5D
    calibration:
      x_min: 0
      x_max: 480
      y_min: 0
      y_max: 480
    on_touch:
      - logger.log:
          format: "Touch erkannt bei X=%.1f Y=%.1f"
          args: [touch.x, touch.y]

spi:
  id: lcd_spi
  clk_pin: {number: GPIO15, allow_other_uses: true}
  mosi_pin: {number: GPIO48, allow_other_uses: true}

uart:
  id: uart_zigbee
  tx_pin: GPIO20
  rx_pin: GPIO19
  baud_rate: 115200

tuya_zigbee_router:
  uart_id: uart_zigbee
  id: zigbee_router_id

output:
  - platform: ledc
    id: backlight_output
    pin: GPIO42
    frequency: 1000Hz

light:
  - platform: monochromatic
    id: display_backlight
    output: backlight_output
    restore_mode: ALWAYS_ON

button:
  - platform: template
    name: "Zigbee Module Restart"
    on_press:
      - tuya_zigbee_router.reset:
          id: zigbee_router_id

display:
  - platform: st7701s
    id: tft_display
    dimensions: {width: 480, height: 480}
    color_order: RGB
    invert_colors: true
    auto_clear_enabled: false
    update_interval: never
    spi_mode: MODE3
    data_rate: 2MHz
    cs_pin: {number: GPIO4, allow_other_uses: true}
    reset_pin: {number: GPIO4, allow_other_uses: true}
    init_sequence:
      - 1
    data_pins:
      red: [GPIO8, GPIO18, GPIO17, GPIO16, GPIO0]
      green: [GPIO13, GPIO12, GPIO11, GPIO10, GPIO9, GPIO3]
      blue: [{number: GPIO15, allow_other_uses: true}, {number: GPIO48, allow_other_uses: true}, GPIO47, GPIO21, GPIO14]
    de_pin: GPIO40
    vsync_pin: GPIO39
    hsync_pin: GPIO38
    pclk_pin:  GPIO41
    pclk_inverted: false
    pclk_frequency: 12MHz
    hsync_pulse_width: 8
    hsync_front_porch: 10
    hsync_back_porch: 50
    vsync_pulse_width: 8
    vsync_front_porch: 10
    vsync_back_porch: 20
    lambda: |-
      it.image(0, 0, id(test_bild));
      it.print(240, 440, id(my_font), TextAlign::CENTER, "Polling-Touch Aktiv");
