esphome:
  name: display-flur
  on_boot:
    priority: 600
    then:
      - delay: 1s
      - output.turn_on: backlight_output

esp32:
  board: esp32-s3-devkitc-1
  variant: esp32s3
  flash_size: 16MB
  cpu_frequency: 240MHz
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_SPIRAM_RODATA: "y"
      CONFIG_SPIRAM_FETCH_INSTRUCTIONS: "y"

psram:
  mode: octal
  speed: 80MHz

logger:
  level: INFO
  baud_rate: 0

wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password
  manual_ip:
    static_ip: !secret static_ip
    gateway: !secret gateway_ip
    subnet: !secret subnet_mask

api:
  reboot_timeout: 0s
  encryption:
    key: !secret api_encryption_key

ota:
  - platform: esphome

# =========================
# BUSSE
# =========================

i2c:
  - id: bus_a
    sda: GPIO07
    scl: GPIO06

spi:
  id: lcd_spi
  clk_pin: {number: GPIO15, allow_other_uses: true}
  mosi_pin: {number: GPIO48, allow_other_uses: true}

# =========================
# BACKLIGHT
# =========================

output:
  - platform: ledc
    id: backlight_output
    pin: GPIO42
    frequency: 1000Hz

# =========================
# TOUCH
# =========================

touchscreen:
  - platform: gt911
    id: panel_touch
    display: tft_display
    i2c_id: bus_a
    address: 0x5D

    on_touch:
      - lambda: |-
          ESP_LOGD("touch", "touch detected");
          id(page) = (id(page) + 1) % 2;
          id(tft_display).update();

# =========================
# GLOBALS
# =========================

globals:
  - id: page
    type: int
    restore_value: no
    initial_value: '0'
  - id: last_button
    type: int
    restore_value: no
    initial_value: '0'

# =========================
# RELAIS (DEIN ORIGINAL)
# =========================

switch:
  - platform: gpio
    pin:
      number: GPIO45
      ignore_strapping_warning: true
    id: relay_1
    name: "Flur Relais 1"

# =========================
# BILD (WICHTIG: PNG!)
# =========================

image:
  - file: "images/bunt.png"
    id: mein_hintergrund
    type: RGB

font:
  - file: "gfonts://Roboto"
    id: font_big
    size: 32

  - file: "gfonts://Roboto"
    id: font_small
    size: 20

# =========================
# DISPLAY (DEIN STABILER SETUP)
# =========================

display:
  - platform: st7701s
    id: tft_display
    spi_id: lcd_spi

    dimensions: {width: 480, height: 480}

    color_order: RGB
    invert_colors: true

    auto_clear_enabled: false
    update_interval: never

    spi_mode: MODE3
    data_rate: 8MHz

    cs_pin: {number: GPIO4, allow_other_uses: true}
    reset_pin: {number: GPIO4, allow_other_uses: true}

    init_sequence:
      - 1

    # STABILES TIMING
    pclk_frequency: 12MHz
    pclk_inverted: false

    hsync_pulse_width: 8
    hsync_back_porch: 10
    hsync_front_porch: 50

    vsync_pulse_width: 8
    vsync_back_porch: 10
    vsync_front_porch: 20

    data_pins:
      red: [GPIO8, GPIO18, GPIO17, GPIO16, GPIO0]
      green: [GPIO13, GPIO12, GPIO11, GPIO10, GPIO9, GPIO3]
      blue:
        - {number: GPIO15, allow_other_uses: true}
        - {number: GPIO48, allow_other_uses: true}
        - GPIO47
        - GPIO21
        - GPIO14

    de_pin: GPIO40
    vsync_pin: GPIO39
    hsync_pin: GPIO38
    pclk_pin: GPIO41

lvgl:
  id: my_lvgl
  buffer_size: 25%
  color_depth: 16

  # 🔥 WICHTIG: verhindert Scrollverhalten
  scrollable: false

  pages:
    - id: main_page

      widgets:

        # =========================
        # HINTERGRUND (fix, kein Scroll)
        # =========================
        - image:
            src: mein_hintergrund
            x: 0
            y: 0
            width: 480
            height: 480

        # =========================
        # BUTTON 1
        # =========================
        - button:
            x: 20
            y: 20
            width: 200
            height: 150
            bg_color: 0x4444FF
            on_press:
              - lambda: |-
                  id(last_button) = 1;
              - script.execute: update_status
            widgets:
              - label:
                  text: "BTN 1"
                  align: CENTER

        # =========================
        # BUTTON 2
        # =========================
        - button:
            x: 260
            y: 20
            width: 200
            height: 150
            bg_color: 0x44FF44
            on_press:
              - lambda: |-
                  id(last_button) = 2;
              - script.execute: update_status
            widgets:
              - label:
                  text: "BTN 2"
                  align: CENTER

        # =========================
        # BUTTON 3
        # =========================
        - button:
            x: 20
            y: 200
            width: 200
            height: 150
            bg_color: 0xFF4444
            on_press:
              - lambda: |-
                  id(last_button) = 3;
              - script.execute: update_status
            widgets:
              - label:
                  text: "BTN 3"
                  align: CENTER

        # =========================
        # BUTTON 4
        # =========================
        - button:
            x: 260
            y: 200
            width: 200
            height: 150
            bg_color: 0xFFFF44

            on_press:
              - lambda: |-
                  id(last_button) = 4;
              - script.execute: update_status

            widgets:
              - label:
                  text: "BTN 4"
                  align: CENTER

        # =========================
        # STATUS ANZEIGE (immer sichtbar)
        # =========================
        - label:
            id: status_label
            x: 0
            y: 0
            width: 480
            height: 100
            align: CENTER
            text: "Touch Test"
            text_align: CENTER
            bg_color: 0x000000
            text_color: 0xFFFFFF

script:
  - id: update_status
    then:
      - lvgl.label.update:
          id: status_label
          text: !lambda |-
            if (id(last_button) == 1) return std::string("Button 1 gedrückt");
            if (id(last_button) == 2) return std::string("Button 2 gedrückt");
            if (id(last_button) == 3) return std::string("Button 3 gedrückt");
            if (id(last_button) == 4) return std::string("Button 4 gedrückt");
            return std::string("Touch Test");
      - component.update: tft_display
