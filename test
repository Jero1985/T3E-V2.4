# --- ZEIT-KOMPONENTE (Hintergrund) ---
time:
  - platform: homeassistant
    id: esptime
    on_time:
      - seconds: 0 # Jede Minute aktualisieren
        then:
          - lambda: |-
              id(clk_time).set_text(id(esptime).now().strftime("%H:%M").c_str());
              id(clk_date).set_text(id(esptime).now().strftime("%a %d %b").c_str());

# --- INTERVALL FÜR DIE LAUFLICHTER (ANIMATION) ---
interval:
  - interval: 40ms # Schnelle Taktrate für flüssige Punkte
    then:
      - lambda: |-
          // 1. PV Lauflicht (Horizontal)
          float w_pv = id(pv_power_aktuell).state; 
          static float pv_pos = 0;
          if (w_pv > 20) { 
            pv_pos += (w_pv / 1000.0f);
            if (pv_pos > 110) pv_pos = -8; 
            id(pv_dot).set_x((int16_t)pv_pos);
            id(pv_dot).set_style_bg_opa(255, 0); 
          } else { id(pv_dot).set_style_bg_opa(0, 0); }

          // 2. Vertikaler Fluss (PV -> Haus)
          static float vert_pos = 0;
          if (w_pv > 20) {
            vert_pos += (w_pv / 1000.0f);
            if (vert_pos > 50) vert_pos = -8; 
            id(widget_1777141006687_ljozy3how).set_y((int16_t)vert_pos);
            id(widget_1777141006687_ljozy3how).set_style_bg_opa(255, 0);
          } else { id(widget_1777141006687_ljozy3how).set_style_bg_opa(0, 0); }

          // 3. Wallbox Fluss (Haus -> Wallbox)
          float w_wb = id(wallbox_power).state;
          static float wb_pos = 0;
          if (w_wb > 50) {
            wb_pos += (w_wb / 2000.0f);
            if (wb_pos > 110) wb_pos = -8;
            id(widget_1777140880066_a4wm6zco7).set_x((int16_t)wb_pos);
            id(widget_1777140880066_a4wm6zco7).set_style_bg_opa(255, 0);
          } else { id(widget_1777140880066_a4wm6zco7).set_style_bg_opa(0, 0); }

