esphome:
  name: display-flur
  on_boot:
    priority: 600
    then:
      - delay: 1s
      - light.turn_on: display_backlight

esp32:
  board: esp32-s3-devkitc-1
  variant: esp32s3
  flash_size: 16MB
  cpu_frequency: 240MHz
  framework:
    type: esp-idf
    sdkconfig_options:
      CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG: "y" 
      CONFIG_SPIRAM_RODATA: "y"
      CONFIG_SPIRAM_FETCH_INSTRUCTIONS: "y"

psram:
  mode: octal
  speed: 80MHz

logger:
  level: INFO
  hardware_uart: UART0 

wifi:
  ssid: "WLAN-2,4-GHz"
  password: "1november08paula"
  use_address: 192.168.2.194
  manual_ip:
    static_ip: 192.168.2.194
    gateway: 192.168.2.1
    subnet: 255.255.255.0

api:
  reboot_timeout: 0s
  encryption: {key: "Njg2NGE1NmE4YmI0NmJlYzhjNjkyM2MwNWRiZDM3Y2Y="}

ota:
  - platform: esphome

globals:
  - id: pv_pos_var
    type: float
    initial_value: '0'
  - id: pv_visible_var
    type: bool
    initial_value: 'false'
  - id: wb_pos_var
    type: float
    initial_value: '0'
  - id: wb_visible_var
    type: bool
    initial_value: 'false'

# --- HOME ASSISTANT ENTITÄTEN ---
sensor:
  - platform: homeassistant
    id: pv_power_aktuell
    entity_id: sensor.pv_leistung_positiv
    on_value:
      then:
        - lvgl.label.update:
            id: pv_aktuell
            text: !lambda 'return str_sprintf("%.1f kW", x);'
  
  - platform: homeassistant
    id: wallbox_power
    entity_id: sensor.cupra_born_charging_power
    on_value:
      then:
        - lvgl.arc.update:
            id: lv_arc_61
            value: !lambda "return (int)((x / 11000.0) * 100.0);"
        - lvgl.label.update:
            id: wallbox_aktuell
            text: !lambda 'return str_sprintf("%.1f kW", x/1000.0);'

binary_sensor:
  - platform: homeassistant
    id: auto_rollo
    entity_id: input_boolean.sonnenschutz_automatik
  - platform: homeassistant
    id: auto_weihnacht
    entity_id: input_boolean.weihnachtsbeleuchtung_automatik
  - platform: homeassistant
    id: status_weihnacht
    entity_id: switch.4_fach_relais_hauptverteilung_l1
  - platform: homeassistant
    id: status_trockner
    entity_id: switch.4_fach_relais_hauptverteilung_l4
  - platform: homeassistant
    id: auto_trockner
    entity_id: input_boolean.lufttrockner_automatik

# --- HARDWARE ---
i2c:
  - id: bus_a
    sda: GPIO07
    scl: GPIO06
    scan: true

touchscreen:
  - platform: gt911
    id: my_touch
    display: tft_display
    i2c_id: bus_a
    address: 0x5D
    reset_pin: GPIO5

output:
  - platform: ledc
    id: backlight_output
    pin: GPIO42
    frequency: 1000Hz

light:
  - platform: monochromatic
    id: display_backlight
    output: backlight_output
    restore_mode: ALWAYS_ON

spi:
  id: lcd_spi
  clk_pin: {number: GPIO15, allow_other_uses: true}
  mosi_pin: {number: GPIO48, allow_other_uses: true}

display:
  - platform: st7701s
    id: tft_display
    spi_id: lcd_spi
    dimensions: {width: 480, height: 480}
    color_order: RGB
    invert_colors: true
    auto_clear_enabled: false
    spi_mode: MODE3
    data_rate: 20MHz
    cs_pin: {number: GPIO4, allow_other_uses: true}
    reset_pin: {number: GPIO4, allow_other_uses: true}
    init_sequence:
      - 1
    data_pins:
      red: [GPIO8, GPIO18, GPIO17, GPIO16, GPIO0]
      green: [GPIO13, GPIO12, GPIO11, GPIO10, GPIO9, GPIO3]
      blue: [{number: GPIO15, allow_other_uses: true}, {number: GPIO48, allow_other_uses: true}, GPIO47, GPIO21, GPIO14]
    de_pin: GPIO40
    vsync_pin: GPIO39
    hsync_pin: GPIO38
    pclk_pin: GPIO41

