# --- ZEIT-SYNCHRONISIERUNG & ANIMATION ---
time:
  - platform: homeassistant
    id: esptime
    on_time:
      - seconds: 0
        then:
          - lvgl.label.update:
              id: clk_time
              text: !lambda 'return id(esptime).now().strftime("%H:%M");'
          - lvgl.label.update:
              id: clk_date
              text: !lambda 'return id(esptime).now().strftime("%a %d %b");'

interval:
  - interval: 40ms
    then:
      - lambda: |-
          float w_pv = id(pv_power_aktuell).state;
          static float pv_pos = 0;
          if (w_pv > 20) {
            pv_pos += (w_pv / 1000.0f);
            if (pv_pos > 110) pv_pos = -8; 
            id(pv_pos_var) = pv_pos;
            id(pv_visible_var) = true;
          } else { id(pv_visible_var) = false; }

          float w_wb = id(wallbox_power).state;
          static float wb_pos = 0;
          if (w_wb > 50) {
            wb_pos += (w_wb / 2000.0f);
            if (wb_pos > 110) wb_pos = -8;
            id(wb_pos_var) = wb_pos;
            id(wb_visible_var) = true;
          } else { id(wb_visible_var) = false; }

      - if:
          condition: { lambda: 'return id(pv_visible_var);' }
          then:
            - lvgl.widget.update:
                id: pv_dot
                x: !lambda 'return (int16_t)id(pv_pos_var);'
                y: 0
          else:
            - lvgl.widget.update: { id: pv_dot, x: -50, y: -50 } 

      - if:
          condition: { lambda: 'return id(wb_visible_var);' }
          then:
            - lvgl.widget.update:
                id: wb_dot
                x: !lambda 'return (int16_t)id(wb_pos_var);'
                y: 0
          else:
            - lvgl.widget.update: { id: wb_dot, x: -50, y: -50 }
